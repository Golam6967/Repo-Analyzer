NODE_ENV=development
PORT=5000

# Clerk — https://clerk.com → Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_...
SIGNING_SECRET=whsec_...
CLERK_WEBHOOK_SECRET=whsec_...

# GitHub — Settings → Developer Settings → Personal access tokens → repo scope
GITHUB_TOKEN=ghp_...

# AI — Q&A (required) — https://console.groq.com
GROQ_API_KEY=gsk_...

# AI — Review (optional, falls back to Groq) — https://aistudio.google.com
GEMINI_API_KEY=AIza...

# PostgreSQL — recommended: Neon (https://neon.tech, free tier)
# Pooled connection (runtime)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Direct connection (Prisma migrations)
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# Deployed frontend URL — required on Vercel to allow CORS from your frontend
FRONTEND_URL=https://your-frontend.vercel.app

# Cloudinary — https://cloudinary.com (profile photo uploads)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
